# ---------- Servidor ----------
PORT=3000
BASE_URL=http://localhost:3000

# ---------- Supabase ----------
# URL del proyecto (Project Settings > API)
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
# Clave publica (anon) -> se usa en el frontend
SUPABASE_ANON_KEY=
# Clave secreta (service_role) -> SOLO backend, nunca en el frontend
SUPABASE_SERVICE_ROLE_KEY=

# ---------- Mercado Pago (cuenta DEDICADA al evento) ----------
# Access Token de la aplicacion de Mercado Pago del evento
MP_ACCESS_TOKEN=
# Secreto de firma del webhook (Your integrations > Webhooks > Signature secret)
MP_WEBHOOK_SECRET=
MP_CURRENCY=ARS

# ---------- Seguridad ----------
# Secreto para autorizar el cron de Vercel (cualquier cadena larga y aleatoria)
CRON_SECRET=cambiame-cadena-larga-aleatoria
